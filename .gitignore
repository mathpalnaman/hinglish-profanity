# Dependencies
node_modules/

# Build output (generated by tsup, published to npm, never committed)
dist/

# Test & coverage output
coverage/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Env files — this package needs none, but nothing secret should ever land here
.env
.env.*
!.env.example

# Scratch: real review exports used to build the corpus.
# Raw production data must NOT be committed. Only curated cases in
# test/fixtures/corpus.jsonl go into git.
scratch/
*.raw.json
*.raw.jsonl
reviews-export*.json

# Internal working notes — not for consumers of the package.
# Kept locally, deliberately untracked.
CLAUDE.md
AUDIT.md
notes/
TODO.md
